{
  "name": "gulp-mu-ft",
  "version": "0.2.0",
  "description": "microFT - Node module to generate icon fonts from SVG glyphs and package webfonts including OpenType color fonts and emoji fonts (TTF/OTF/WOFF/WOFF2, CSS, HTML overview).",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "mocha test/**/*.test.mjs"
  },
  "keywords": [
    "gulp",
    "font",
    "icon",
    "icomoon",
    "svg",
    "ttf",
    "woff",
    "woff2",
    "color-font",
    "colr",
    "emoji",
    "css",
    "microgulp",
    "ugulp"
  ],
  "microgulp": {
    "ready": true,
    "certifiedSince": "0.1.5",
    "gulpfile": "../gulpfile.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mamekudz/microCSS.git",
    "directory": "gulp-mu-ft"
  },
  "homepage": "https://github.com/mamekudz/microCSS/tree/master/gulp-mu-ft#readme",
  "bugs": {
    "url": "https://github.com/mamekudz/microCSS/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^15.0.1",
    "ttf2eot": "^3.1.0",
    "ttf2woff": "^3.0.0",
    "ttf2woff2": "^8.0.1"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.6"
  }
}
